		<body>
			<trans-unit id="StartScreen_Badge" resname="StartScreen_Badge">
				<source>TECH NOTE</source>
				<target>テクニカルノート</target>
			</trans-unit>
			<trans-unit id="StartScreen_Wordmark" resname="StartScreen_Wordmark">
				<source>SEMANTIC ICON SEARCH</source>
